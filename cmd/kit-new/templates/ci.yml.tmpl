name: ci
on:
  pull_request:
  push:
    branches: [main]

# Drop the default read-write GITHUB_TOKEN to least privilege, matching
# the rho-kit repo's own CI. CI only reads the checkout; no job needs
# write scope.
permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - uses: actions/setup-go@d8cbb8045d7f43706b9177cceb36c1f91a6644d5 # v7.1.0
        with:
          go-version: '1.27.4'
      - run: make lint
      - run: make build
      - run: make test
      - run: make doctor
